{
  "expo": {
    "name": "Flow Ledger",
    "slug": "flow-ledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#003366"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.flowledger.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#003366"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Flow Ledger uses the camera to scan item QR codes and barcodes.",
          "recordAudioAndroidEnabled": false
        }
      ]
    ]
  }
}
