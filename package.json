{
  "name": "marg-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:erp && npm run build:admin",
    "build:erp": "esbuild client/main.ts --bundle --outfile=public/app.js --target=es2020 --sourcemap",
    "build:admin": "esbuild admin/main.ts --bundle --outfile=admin-public/admin.js --target=es2020 --sourcemap",
    "dev": "npm run build && tsx server/index.ts",
    "start": "npm run build && tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
